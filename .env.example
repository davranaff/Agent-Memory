# Database
POSTGRES_URL=postgresql+asyncpg://agent:agentpass@postgres:5432/agent_brain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass
POSTGRES_DB=agent_brain

# Redis
REDIS_URL=redis://redis:6379/0

# MCP
MCP_ENABLED=true
PROJECT_PATH_MAPPINGS=
HOST_PROJECTS_ROOT=..

# Ollama (local LLM)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embedding provider: ollama | openai | local
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# OpenAI-compatible (optional, for agent reasoning or embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM provider: ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Orchestration
ORCHESTRATION_ENABLED=true
ORCHESTRATION_MAX_PARALLEL_AGENTS=4
ORCHESTRATION_MAX_RETRIES=3

# Graph backend: inmemory | neo4j
GRAPH_BACKEND=inmemory
GRAPH_FALLBACK_TO_INMEMORY=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Security / CORS
API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-API-Key
