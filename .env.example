# Database
POSTGRES_URL=postgresql+asyncpg://agent:agentpass@postgres:5432/agent_brain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass
POSTGRES_DB=agent_brain

# Redis
REDIS_URL=redis://redis:6379/0

# MCP
MCP_ENABLED=true

# Ollama (local LLM)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embedding provider: ollama | openai | local
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# OpenAI-compatible (optional, for agent reasoning or embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM provider: ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Orchestration
ORCHESTRATION_ENABLED=true
ORCHESTRATION_MAX_PARALLEL_AGENTS=4
ORCHESTRATION_MAX_RETRIES=3
